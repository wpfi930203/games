{
  "name": "neon-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NEON RUSH - 第三人称 3D 赛车游戏 (Three.js + Cannon-es + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-standalone.mjs",
    "preview": "vite preview --port 4173 --host",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-cdp.mjs http://localhost:4173/"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "dat.gui": "^0.7.9",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/dat.gui": "^0.7.13",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
